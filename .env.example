# Supabase Project Settings > API. Only these two values are public.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Supabase Connect > Transaction pooler, port 6543; encode password.
DATABASE_URL=
# Optional: database root certificate from Supabase when required for TLS validation.
DATABASE_CA_CERT=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
# Generate each independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
IDENTITY_LOOKUP_PEPPER=
# Optional until the approved identity adapter is ready. Enrolment fails closed.
IDENTITY_PROVIDER_URL=
IDENTITY_PROVIDER_TOKEN=
# Only in a SEPARATE fictional demo project; never enable on real customer data.
SAFEBET_DEMO_MODE=false
# Local seed only: JSON array of 15 controlled email addresses. Never NEXT_PUBLIC.
PILOT_ACCOUNT_EMAILS=
